{
  "name": "llmesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/electron/main.js",
  "description": "Hardware-aware Qwen inference over an encrypted peer mesh, with an opt-in public OpenAI-compatible API",
  "scripts": {
    "build:ui": "node scripts/build-ui.js",
    "contracts:compile": "node scripts/compile-contracts.js",
    "chain": "node scripts/local-chain.js",
    "contracts:deploy": "node scripts/deploy.js",
    "prestart": "npm run build:ui",
    "presmoke": "npm run build:ui",
    "prepack": "npm run build:ui",
    "predist": "npm run build:ui",
    "start": "electron .",
    "headless": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:live": "node scripts/live-inference-e2e.js",
    "check": "npm run check:syntax && npm run contracts:compile && npm test",
    "smoke": "electron scripts/smoke.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "models:bundle": "node scripts/bundle-model.js",
    "icons:build": "electron scripts/build-icons.cjs",
    "check:syntax": "node scripts/check.js",
    "build:web": "node scripts/build-web.js",
    "models:verify": "node scripts/verify-vendor-assets.js",
    "models:pin": "node scripts/pin-native-assets.js"
  },
  "engines": {
    "node": ">=22.16"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "zod": "^4.6.6"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.86",
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0",
    "hyperswarm": "^4.0.0",
    "jsqr": "^1.4.0",
    "nostr-tools": "^2.0.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "systeminformation": "^5.0.0",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@hyperswarm/secret-stream": "^6.9.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "solc": "^0.8.38",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "build": {
    "appId": "net.llmesh.desktop",
    "productName": "LLMesh",
    "files": [
      "src/**/*",
      "models/catalog.json",
      "package.json",
      "assets/branding/**/*",
      "models/vault.json",
      "vendor/llama.cpp/**/*"
    ],
    "asarUnpack": [
      "node_modules/**/*.node",
      "node_modules/**/prebuilds/**/*",
      "node_modules/**/build/Release/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/branding/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/branding/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/branding/icon.png"
    },
    "extraResources": [
      {
        "from": "models/ollama",
        "to": "model-bundle",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "assets/branding/icon.png",
    "nsis": {
      "installerIcon": "assets/branding/icon.ico",
      "uninstallerIcon": "assets/branding/icon.ico",
      "installerHeaderIcon": "assets/branding/icon.ico",
      "createDesktopShortcut": true,
      "shortcutName": "LLMesh"
    }
  }
}
